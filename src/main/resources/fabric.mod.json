{
  "schemaVersion": 1,
  "id": "safariking",
  "version": "${version}",
  "name": "Safari King",
  "icon": "assets/safariking/icon.png",
  "description": "Safari capture and shard stats, missing-critter HUD, party queries, and location-aware visual helpers. Includes Safari Critter Stats: do not install both mods.",
  "authors": ["kikuj197-star"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.safariking.SafariKingMod"],
    "modmenu": ["com.safariking.ModMenuIntegration"]
  },
  "mixins": [
    "safariking.mixins.json",
    "safariking.stats.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "hypixel-mod-api": ">=1.0.2",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  },
  "breaks": {
    "safaricritterstats": "*"
  },
  "contact": {
    "homepage": "https://github.com/kikuj197-star/safari-king",
    "sources": "https://github.com/kikuj197-star/safari-king",
    "issues": "https://github.com/kikuj197-star/safari-king/issues"
  }
}
